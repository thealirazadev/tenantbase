APP_NAME=tenantbase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tenantbase.test

# Central domain. Tenants live at {slug}.APP_DOMAIN.
APP_DOMAIN=tenantbase.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only. Connect as a NOSUPERUSER NOBYPASSRLS role, never as postgres.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tenantbase
DB_USERNAME=tenantbase_app
DB_PASSWORD=secret

# Leading dot so one session spans the central domain and every tenant subdomain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tenantbase.test

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tenantbase.test"
MAIL_FROM_NAME="${APP_NAME}"

INVITATION_TTL_DAYS=7
