{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "thealirazadev/tenantbase",
    "type": "project",
    "description": "Multi-tenant SaaS foundation for Laravel with double-enforced tenant isolation.",
    "keywords": [
        "laravel",
        "multi-tenancy",
        "postgresql",
        "row-level-security"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "12.64.0",
        "laravel/tinker": "2.11.1"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "laravel/pint": "1.29.3",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.9.5",
        "pestphp/pest": "4.7.5",
        "pestphp/pest-plugin-laravel": "4.1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "TenantBase\\Tenancy\\": "src/Tenancy/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
